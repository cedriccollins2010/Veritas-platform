# Copier ce fichier en .env puis remplacer les valeurs. Le fichier .env n'est jamais versionné.

APP_ENV=development

# Deux comptes PostgreSQL, deux mots de passe différents :
# - veritas_user : propriétaire des tables, utilisé seulement pour les migrations ;
# - veritas_app_user : compte de l'API, privilèges minimaux (migration 0002).
POSTGRES_PASSWORD=change_me
APP_DB_PASSWORD=change_me_app

# Utilisés quand le backend tourne hors Docker (uvicorn et alembic sur ta machine).
DATABASE_URL=postgresql+psycopg://veritas_app_user:change_me_app@localhost:5432/veritas
MIGRATION_DATABASE_URL=postgresql+psycopg://veritas_user:change_me@localhost:5432/veritas

# Origines autorisées à appeler l'API depuis un navigateur, séparées par des virgules.
CORS_ORIGINS=http://localhost:3000

# Durée de vie d'une session de connexion, en heures.
SESSION_LIFETIME_HOURS=12

# Taille maximale d'un fichier téléversé, en Mo.
MAX_UPLOAD_SIZE_MB=500

# Adresse de l'API vue par le serveur Next.js (hors Docker).
API_INTERNAL_URL=http://localhost:8000
