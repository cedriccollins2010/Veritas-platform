# Copier ce fichier en .env puis remplacer les valeurs. Le fichier .env n'est jamais versionné.

APP_ENV=development

# Mot de passe PostgreSQL local (Docker Compose construit DATABASE_URL à partir de lui).
POSTGRES_PASSWORD=change_me

# Utilisé quand le backend tourne hors Docker (uvicorn sur ta machine).
DATABASE_URL=postgresql+psycopg://veritas_user:change_me@localhost:5432/veritas

# Origines autorisées à appeler l'API depuis un navigateur, séparées par des virgules.
CORS_ORIGINS=http://localhost:3000

# Taille maximale d'un fichier téléversé, en Mo.
MAX_UPLOAD_SIZE_MB=500

# Adresse de l'API vue par le serveur Next.js (hors Docker).
API_INTERNAL_URL=http://localhost:8000
